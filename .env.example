# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Production : au moins 24 caracteres aleatoires (obligatoire sur Render)
SECRET_KEY=une-longue-chaine-aleatoire-a-generer
FLASK_ENV=development

# Admin bootstrap / reset one-shot (production). Min 10 caracteres.
# ADMIN_PASSWORD=ChoisisUnMotDePasseFort
# FORCE_ADMIN_PASSWORD_RESET=1
# RESET_BASE_JETON=nettoyer-lundi-1   # one-shot : nettoie la base, garde admin SAMSON

# mysql+pymysql://utilisateur:motdepasse@localhost:3306/bbda_events_db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/bbda_events_db

# Emails :
# - Local : SMTP Gmail
#     MAIL_USERNAME=ton-compte@gmail.com
#     MAIL_PASSWORD=mot-de-passe-application-gmail
# - Render free : SendGrid API (Single Sender verifie, pas besoin de domaine)
#     SENDGRID_API_KEY=SG....
#     MAIL_USERNAME=email-verifie-chez-sendgrid@gmail.com
MAIL_USERNAME=ton-compte@gmail.com
MAIL_PASSWORD=mot-de-passe-application-gmail
# SENDGRID_API_KEY=

# URL publique pour les liens des emails (quittance, etc.).
# Laisser vide en local pur (127.0.0.1).
PUBLIC_BASE_URL=

# Tunnel public pour tests telephone :
#   ngrok  = lien STABLE (recommande) — lancer configurer_lien_stable.ps1
#   quick  = Cloudflare trycloudflare (URL change a chaque fois)
TUNNEL_MODE=ngrok
# Domaine gratuit fixe (page Domains du dashboard ngrok)
# Exemple : quit-easeful-unworn.ngrok-free.dev
NGROK_DOMAIN=
