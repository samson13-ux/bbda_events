# Environnement Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Binaire ngrok local (telecharge pour le lien stable)
tools/ngrok/

# Secrets
.env
.public_url
.flask_public.log
.flask_public.err
.flask_restart.log
.flask_restart.err
.tunnel.log
.tunnel.out.log
.tunnel.err.log
flask_err.log
flask_out.log
