# Fichiers generes par l'application
frontend/static/uploads/*
!frontend/static/uploads/.gitkeep
frontend/static/quittances/*
!frontend/static/quittances/.gitkeep

# Editeurs / OS / outils locaux
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
.qodo/
.git_staged_list.txt
tmp_*.html
*.tmp
*.bak

# Gros fichiers locaux non necessaires au deploiement
